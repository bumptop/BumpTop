diff --git a/OgreMain/include/OgreRenderable.h b/OgreMain/include/OgreRenderable.h
index ec3c8a5..da59431 100644
--- a/OgreMain/include/OgreRenderable.h
+++ b/OgreMain/include/OgreRenderable.h
@@ -75,6 +75,37 @@ namespace Ogre {
         }
         /** Virtual destructor needed as class has virtual methods. */
         virtual ~Renderable() {}
+
+        // --- BumpTop patch (#ManuallySpecifyingRenderOrder) ---
+        // Lets a transparent renderable declare that it renders immediately
+        // before/after another renderable in the same render queue group.
+        // Consumed by DistanceSortDescendingLess in
+        // OgreRenderQueueSortingGrouping.cpp.
+        void setToRenderBefore(Renderable* renderable)
+        {
+            mRenderableToRenderNextTo = renderable;
+            mRenderAfterTheRenderableToRenderNextTo = false;
+            mRenderOrderTiedToOtherRenderable = (renderable != NULL);
+        }
+        void setToRenderAfter(Renderable* renderable)
+        {
+            mRenderableToRenderNextTo = renderable;
+            mRenderAfterTheRenderableToRenderNextTo = true;
+            mRenderOrderTiedToOtherRenderable = (renderable != NULL);
+        }
+        Renderable* getRenderableToRenderNextTo(void) const
+        {
+            return mRenderOrderTiedToOtherRenderable ? mRenderableToRenderNextTo : NULL;
+        }
+        bool renderAfterOtherRenderable(void) const
+        {
+            return mRenderOrderTiedToOtherRenderable && mRenderAfterTheRenderableToRenderNextTo;
+        }
+        bool renderOrderTiedToOtherRenderable(void) const
+        {
+            return mRenderOrderTiedToOtherRenderable;
+        }
+        // --- end BumpTop patch ---
         /** Retrieves a weak reference to the material this renderable object uses.
 
             Note that the Renderable also has the option to override the getTechnique method
@@ -358,6 +389,10 @@ namespace Ogre {
