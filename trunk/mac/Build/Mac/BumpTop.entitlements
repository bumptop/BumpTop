<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notarization requires the hardened runtime; these entitlements keep
	     the app's legacy behaviors working under it. -->
	<!-- AppleScript to Finder: desktop icon positions, drive list. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
